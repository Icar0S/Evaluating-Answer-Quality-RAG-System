# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
GENERATION_TIMEOUT_SECONDS=120

# --- Provider remoto (opcional — API do Mac mini, ver llm-api-referencia.md) ---
# NÃO é um Ollama: é uma API própria com Bearer auth, fila e sem rota de
# embeddings (embeddings continuam sempre locais). Preencha para habilitar a
# opção "Servidor" no seletor do monitor. Deixe em branco para manter o
# comportamento 100% local de hoje. NUNCA commite a chave real — só no .env.
REMOTE_API_BASE_URL=
REMOTE_API_KEY=
REMOTE_GENERATION_MODEL=
REMOTE_LABEL=Servidor (Mac mini)

# --- Provider ativo ao iniciar o backend (local | remote) ---
# Trocável em runtime sem restart via POST /providers/active — isto só define o padrão no boot.
ACTIVE_PROVIDER=local

# --- Chunking ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- Retrieval ---
TOP_K=4
# Piso de similaridade (0..1) para um chunk entrar no contexto. 0.0 = sem filtro
# (comportamento historico). Acima de 0, pergunta fora do corpus chega na geracao
# com contexto vazio e dispara a frase de abstencao em vez de responder apoiada
# em trecho irrelevante.
MIN_SIMILARITY_SCORE=0.0
# MMR (relevancia x diversidade) na selecao final dos chunks. Desligado por
# padrao; o estudo de mutacao liga na configuracao dele.
RETRIEVAL_USE_MMR=false
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_FETCH_MULTIPLIER=3

# --- Paths ---
SOURCE_PDFS_DIR=data/source_pdfs
VECTOR_STORE_DIR=data/vector_store
VECTOR_STORE_COLLECTION=rag_test_specialist
LOGS_DIR=logs

# --- Geracao ---
# Vazio = nao envia `options` ao Ollama (mantem o default do modelo). Fixar em
# 0.0 nao torna a geracao deterministica, mas evita amplificar a variancia.
GENERATION_TEMPERATURE=
GENERATION_SEED=

# --- Blocos do system prompt (cada um ligavel/desligavel) ---
# Os defaults reproduzem exatamente o prompt v1. Os operadores de mutacao P1-P3
# (tests/mutation/) desligam um bloco cada.
PROMPT_REQUIRE_GROUNDING=true
PROMPT_REQUIRE_ABSTENTION=true
PROMPT_REQUIRE_CITATION=false

# --- Prompt versioning (bump when the system prompt changes materially) ---
PROMPT_VERSION=v1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- Avaliação DeepEval (tests/deepeval/, Fase 2 — ver tests/deepeval/README.md) ---
# Opt-out de telemetria anônima do pacote deepeval, ligado por padrão aqui.
DEEPEVAL_TELEMETRY_OPT_OUT=1
# Modelo juiz local via Ollama — deliberadamente diferente de GENERATION_MODEL
# pra não auto-avaliar a própria resposta (self-grading bias).
DEEPEVAL_JUDGE_MODEL=gemma3:4b
# O timeout padrão do deepeval é calibrado pra juízes rápidos (nuvem); um
# juiz local pode legitimamente levar mais tempo. Teto generoso mas finito —
# não desligar o timeout por completo (DEEPEVAL_DISABLE_TIMEOUTS): sem teto
# nenhum, uma chamada que trava (ex. juiz com "thinking" preso num loop de
# raciocínio) trava a rodada inteira pra sempre, sem chance de recuperação.
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=240

# --- Estudo de mutacao (tests/mutation/, protocolo IST/VSI:EQUISA) ---
# A camada de mutacao NAO le parametros do .env: a configuracao do estudo fica
# em tests/mutation/config/study.yaml e e aplicada como overlay em memoria, para
# nao depender do .env da maquina nem alterar o assistente em producao. Daqui ela
# usa so OLLAMA_BASE_URL. Ver tests/mutation/README.md.
