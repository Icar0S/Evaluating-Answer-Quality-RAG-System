# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
GENERATION_TIMEOUT_SECONDS=120

# --- Chunking ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- Retrieval ---
TOP_K=4
MIN_SIMILARITY_SCORE=0.0

# --- Paths ---
SOURCE_PDFS_DIR=data/source_pdfs
VECTOR_STORE_DIR=data/vector_store
VECTOR_STORE_COLLECTION=rag_test_specialist
LOGS_DIR=logs

# --- Prompt versioning (bump when the system prompt changes materially) ---
PROMPT_VERSION=v1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
