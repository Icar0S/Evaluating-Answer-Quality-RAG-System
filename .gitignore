# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# frontend
frontend/home/node_modules/

# Env
.env

# Dados e artefatos gerados (reprodutíveis via ingest, não versionados)
data/source_pdfs/*
!data/source_pdfs/.gitkeep
data/vector_store/*
!data/vector_store/.gitkeep
logs/*.jsonl
!logs/.gitkeep

# Testes
tests/deepeval/results/*
!tests/deepeval/results/.gitkeep
.deepeval/
tests/human_review/annotations/*
!tests/human_review/annotations/.gitkeep
node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/

# Editor/OS
.vscode/
.DS_Store
.aider*

# Estudo de mutação (tests/mutation/, ver o README de lá)
tests/mutation/.venv/
tests/mutation/work/
tests/mutation/results/*
!tests/mutation/results/.gitkeep
tests/mutation/suite/drafts.jsonl
# Os PDFs do corpus ficam de fora ENQUANTO as licenças não estiverem resolvidas
# em corpus/sources.yaml — o corpus precisa ser redistribuível para ir ao pacote
# de replicação. Resolvidas as licenças, remova estas duas linhas e versione o
# corpus: ele é artefato do estudo, não subproduto. O manifesto e o registro das
# variantes continuam versionados de qualquer forma (são pequenos e é o que
# permite auditar o que mudou).
tests/mutation/corpus/base/
tests/mutation/corpus/variants/*.pdf
